@bot.tree.command(name="identity", description="إنشاء هوية RP")
@app_commands.describe(
    name="اسم الشخصية",
    age="العمر",
    job="الوظيفة",
    city="المدينة"
)
async def identity(
    interaction: discord.Interaction,
    name: str,
    age: int,
    job: str,
    city: str
):

    cur.execute("""
    INSERT OR REPLACE INTO identities
    (user_id, name, age, job, city)
    VALUES (?, ?, ?, ?, ?)
    """, (
        interaction.user.id,
        name,
        age,
        job,
        city
    ))

    db.commit()

    embed = discord.Embed(
        title="🪪 هوية RP",
        description="تم إنشاء هويتك بنجاح.",
    )

    embed.add_field(
        name="👤 الاسم",
        value=name,
        inline=False
    )

    embed.add_field(
        name="🎂 العمر",
        value=str(age),
        inline=True
    )

    embed.add_field(
        name="💼 الوظيفة",
        value=job,
        inline=True
    )

    embed.add_field(
        name="🏙️ المدينة",
        value=city,
        inline=True
    )

    await interaction.response.send_message(
        embed=embed
    )


